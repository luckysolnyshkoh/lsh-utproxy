[Unit]
Description=lsh-utproxy TCP/UDP proxy (HAProxy-like)
Documentation=https://fill.me/
After=network.target network-online.target
Wants=network-online.target

[Service]
User=nobody
Group=nogroup
WorkingDirectory=/opt/lsh-utproxy
ExecStart=/opt/lsh-utproxy/cmd/lsh-utproxy/lsh-utproxy -c /opt/lsh-utproxy/config/main.cfg
ExecReload=/bin/pkill -9 lsh-utproxy ; /opt/lsh-utproxy/cmd/lsh-utproxy/lsh-utproxy -c /opt/lsh-utproxy/config/main.cfg
ExecStop=/bin/pkill -9 lsh-utproxy
Restart=always
RestartSec=2
LimitNOFILE=1048576
LimitNPROC=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/lsh-utproxy

# EnvironmentFile=-/etc/default/lsh-utproxy

[Install]
WantedBy=multi-user.target
