# Optional overrides for the systemd unit (systemd reads EnvironmentFile).
# The binary does not read these variables yet; the unit file uses them only as
# documentation of the intended layout.

# Where the config lives:
#   CONFIG=/opt/lsh-utproxy/config/lsh-utproxy.cfg
# Log level (also settable in the config file, "log ... level <lvl>"):
#   LOG_LEVEL=info
